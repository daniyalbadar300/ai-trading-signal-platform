# ── Core ─────────────────────────────────────────────
APP_NAME=ai-trading-signal-platform
ENV=dev
LOG_LEVEL=INFO

# ── Market Data ──────────────────────────────────────
# binance = live data (no API key needed) | mock = deterministic fake data
DATA_PROVIDER=binance
BINANCE_BASE_URL=https://api.binance.com
SYMBOLS=BTCUSDT,ETHUSDT,SOLUSDT
DEFAULT_INTERVAL=1m
CANDLE_LIMIT=300

# ── Signal Engine ────────────────────────────────────
SIGNAL_THRESHOLD=0.15

# ── Worker (phase 2) ─────────────────────────────────
WORKER_INTERVAL_SECONDS=60
WORKER_ENABLED=true
SIGNALS_HISTORY_LIMIT=50

# ── Caching (phase 4+) ───────────────────────────────
CACHE_TTL_SECONDS=30
REDIS_URL=redis://localhost:6379/0

# ── Database (phase 4+) ──────────────────────────────
DATABASE_URL=postgresql+asyncpg://trader:trader@localhost:5432/trading

# ── Metrics (phase 7) ────────────────────────────────
# Prometheus text endpoint at /metrics (API) or :8000 (standalone worker).
METRICS_ENABLED=false

# ── AI Layer (optional) ──────────────────────────────
# Works with any OpenAI-compatible API: OpenAI, Gemini, Groq, Ollama...
# If left empty, rule-based fallback commentary is used.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini
